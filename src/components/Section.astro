---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  /** Heading level for the section title. */
  level?: 'h1' | 'h2';
  class?: string;
  /** Tighter vertical padding. */
  compact?: boolean;
  reveal?: boolean;
}

const {
  id,
  eyebrow,
  title,
  intro,
  level = 'h2',
  class: className,
  compact = false,
  reveal = true,
} = Astro.props;

const Heading = level;
const hasHeader = Boolean(eyebrow || title || intro || Astro.slots.has('actions'));
---

<section id={id} class:list={[compact ? 'py-12 md:py-16' : 'py-16 md:py-24', className]}>
  <div class="container-content">
    {
      hasHeader && (
        <div
          class="mb-10 flex flex-col gap-6 md:mb-12 md:flex-row md:items-end md:justify-between"
          data-reveal={reveal ? '' : undefined}
        >
          <div class="max-w-2xl">
            {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
            {title && (
              <Heading class="text-2xl font-semibold tracking-tight text-fg md:text-3xl">{title}</Heading>
            )}
            {intro && <p class="mt-3 text-base leading-relaxed text-fg-muted md:text-lg">{intro}</p>}
          </div>
          {Astro.slots.has('actions') && (
            <div class="flex shrink-0 flex-wrap gap-3">
              <slot name="actions" />
            </div>
          )}
        </div>
      )
    }
    <slot />
  </div>
</section>
