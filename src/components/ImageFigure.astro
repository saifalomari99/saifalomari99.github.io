---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  widths?: number[];
  sizes?: string;
  /** Eager-load and prioritize (use for the page hero only). */
  priority?: boolean;
  class?: string;
  imgClass?: string;
  /** Optional link target (e.g. a full-size image URL). */
  href?: string;
}

const {
  src,
  alt,
  caption,
  widths = [480, 800, 1200, 1600],
  sizes = '(min-width: 1024px) 960px, 100vw',
  priority = false,
  class: className,
  imgClass,
  href,
} = Astro.props;

const format = src.format === 'svg' ? 'svg' : src.format === 'gif' ? 'gif' : 'webp';
const usableWidths = widths.filter((w) => w <= src.width);
if (usableWidths.length === 0 || usableWidths[usableWidths.length - 1] !== src.width) usableWidths.push(src.width);
---

<figure class:list={['overflow-hidden rounded-xl border border-border bg-surface', className]}>
  {
    href ? (
      <a href={href} target="_blank" rel="noopener noreferrer" class="block" aria-label={`Open full-size image: ${alt}`}>
        <Image
          src={src}
          alt={alt}
          widths={usableWidths}
          sizes={sizes}
          format={format}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
          class:list={['block h-auto w-full', imgClass]}
        />
      </a>
    ) : (
      <Image
        src={src}
        alt={alt}
        widths={usableWidths}
        sizes={sizes}
        format={format}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
        class:list={['block h-auto w-full', imgClass]}
      />
    )
  }
  {caption && <figcaption class="border-t border-border px-4 py-3 text-sm leading-relaxed text-fg-subtle">{caption}</figcaption>}
</figure>
