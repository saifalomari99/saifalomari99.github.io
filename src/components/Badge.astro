---
interface Props {
  variant?: 'tech' | 'category' | 'type' | 'accent';
  class?: string;
}

const { variant = 'tech', class: className } = Astro.props;

const variants = {
  tech: 'border-border bg-elevated/70 text-fg-muted',
  category: 'border-accent/40 bg-accent-soft text-accent-2',
  type: 'border-border bg-surface text-fg-subtle',
  accent: 'border-accent-2/40 bg-accent-2/10 text-accent-2',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1 rounded-md border px-2 py-0.5 font-mono text-[0.6875rem] leading-5 tracking-wide whitespace-nowrap',
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
