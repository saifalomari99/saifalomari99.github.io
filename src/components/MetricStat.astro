---
interface Props {
  value: string;
  label: string;
  context?: string;
  class?: string;
}

const { value, label, context, class: className } = Astro.props;
---

<div class:list={['card flex flex-col gap-1 p-5', className]}>
  <p class="font-mono text-3xl font-semibold tracking-tight text-gradient md:text-4xl">{value}</p>
  <p class="text-sm font-medium text-fg">{label}</p>
  {context && <p class="text-sm leading-relaxed text-fg-subtle">{context}</p>}
</div>
