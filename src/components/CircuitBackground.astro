---
/**
 * Decorative hero background: a faint perfboard dot grid with a few PCB-style
 * traces kept to the far right, away from the headline. Pure inline SVG,
 * aria-hidden, very low contrast so text on top stays fully readable.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['pointer-events-none absolute inset-0 overflow-hidden', className]} aria-hidden="true">
  <svg class="absolute inset-0 h-full w-full" viewBox="0 0 1440 640" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="dot-grid" width="28" height="28" patternUnits="userSpaceOnUse">
        <circle cx="14" cy="14" r="1.1" fill="#2563eb" fill-opacity="0.16" />
      </pattern>
      <linearGradient id="fade-left" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fff" stop-opacity="0" />
        <stop offset="0.45" stop-color="#fff" stop-opacity="0.35" />
        <stop offset="1" stop-color="#fff" stop-opacity="1" />
      </linearGradient>
      <linearGradient id="fade-bottom" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fff" stop-opacity="1" />
        <stop offset="0.8" stop-color="#fff" stop-opacity="1" />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
      <mask id="hero-mask">
        <rect width="1440" height="640" fill="url(#fade-left)" />
        <rect width="1440" height="640" fill="url(#fade-bottom)" style="mix-blend-mode: multiply" />
      </mask>
      <radialGradient id="glow" cx="0.85" cy="0.3" r="0.55">
        <stop offset="0" stop-color="#2563eb" stop-opacity="0.09" />
        <stop offset="1" stop-color="#2563eb" stop-opacity="0" />
      </radialGradient>
    </defs>

    <rect width="1440" height="640" fill="url(#glow)" />

    <g mask="url(#hero-mask)">
      <rect width="1440" height="640" fill="url(#dot-grid)" />

      <!-- A few quiet traces on the right edge only -->
      <g fill="none" stroke="#2563eb" stroke-opacity="0.16" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M1440 96h-120l-28 28v120l-28 28h-80" />
        <path d="M1440 420h-70l-28-28V300l-28-28h-96" />
        <path d="M1240 640V560l28-28h100" />
        <path d="M1130 20v120l-28 28H980" />
      </g>
      <g fill="#ffffff" stroke="#2563eb" stroke-opacity="0.35" stroke-width="2">
        <circle cx="1184" cy="272" r="5" />
        <circle cx="1218" cy="272" r="5" />
        <circle cx="1368" cy="532" r="5" />
        <circle cx="980" cy="168" r="5" />
      </g>
      <g fill="#2563eb" fill-opacity="0.35">
        <circle cx="1440" cy="96" r="3" />
        <circle cx="1440" cy="420" r="3" />
        <circle cx="1130" cy="20" r="3" />
      </g>
    </g>
  </svg>
</div>
