---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/Badge.astro';
import ImageFigure from '@/components/ImageFigure.astro';
import Prose from '@/components/Prose.astro';
import { getArticles, articleUrl, type Article } from '@/lib/projects';
import { formatLongDate } from '@/lib/dates';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props {
  article: Article;
}
const { article } = Astro.props;
const { data } = article;
const { Content } = await render(article);
const siteUrl = Astro.site ?? new URL(site.url);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    datePublished: data.pubDate.toISOString(),
    dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
    author: { '@type': 'Person', name: site.name, url: site.url },
    url: new URL(articleUrl(article), siteUrl).toString(),
  },
];
---

<BaseLayout title={data.title} description={data.description} ogType="article" jsonLd={jsonLd}>
  <article class="container-content py-12 md:py-16">
    <header class="mx-auto max-w-3xl">
      <nav aria-label="Breadcrumb" class="mb-6 font-mono text-xs text-fg-subtle">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-fg">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/writing/" class="hover:text-fg">Writing</a></li>
        </ol>
      </nav>
      <p class="font-mono text-xs text-fg-subtle">
        <time datetime={data.pubDate.toISOString()}>{formatLongDate(data.pubDate)}</time>
        {data.updatedDate && <span> &middot; Updated {formatLongDate(data.updatedDate)}</span>}
      </p>
      <h1 class="mt-3 text-3xl font-semibold leading-tight tracking-tight text-fg md:text-5xl">{data.title}</h1>
      <p class="mt-4 text-lg text-fg-muted">{data.description}</p>
      {
        data.tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-1.5">
            {data.tags.map((t) => (
              <Badge>{t}</Badge>
            ))}
          </div>
        )
      }
      {
        data.hero && (
          <div class="mt-8">
            <ImageFigure src={data.hero.src} alt={data.hero.alt} priority />
          </div>
        )
      }
    </header>
    <div class="mx-auto mt-10 max-w-3xl">
      <Prose>
        <Content />
      </Prose>
    </div>
  </article>
</BaseLayout>
